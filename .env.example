# Copy to .env (gitignored) and fill in.
CF_ACCOUNT_ID=
# API token with permission to manage Realtime/Calls TURN keys
# (and Workers Scripts: Edit, if you use deploy.sh).
CF_API_TOKEN=

# Optional: token with "Account Analytics: Read". Enables the Worker's usage cap
# and bin/usage.sh. (bin/usage.sh falls back to CF_API_TOKEN if unset.)
# CF_ANALYTICS_TOKEN=

# Optional
# TURN_KEY_NAME=togetherness
# WORKER_URL=https://tt-turn-credentials.<your-subdomain>.workers.dev
# TEST_ORIGIN=https://apps.example.com   # default: first origin chosen in setup.sh
